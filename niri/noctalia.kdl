layout {

    focus-ring {
        active-color   "#b3c5ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b3c5ff"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#b3c5ff"
        inactive-color "#20428f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b3c5ff80"
    }
}

recent-windows {
    highlight {
        active-color "#b3c5ff"
        urgent-color "#ffb4ab"
    }
}
