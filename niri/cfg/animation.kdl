animations {
    window-open {
        duration-ms 350
        curve "cubic-bezier" 0.16 1.0 0.3 1.0
    }

    window-close {
        duration-ms 200
        curve "cubic-bezier" 0.16 1.0 0.3 1.0
    }

    workspace-switch {
        duration-ms 350
        curve "cubic-bezier" 0.16 1.0 0.3 1.0
    }

    window-movement {
        duration-ms 300
        curve "cubic-bezier" 0.16 1.0 0.3 1.0
    }

    window-resize {
        duration-ms 300
        curve "cubic-bezier" 0.16 1.0 0.3 1.0
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        duration-ms 350
        curve "cubic-bezier" 0.16 1.0 0.3 1.0
    }

    slowdown 1.2
}

