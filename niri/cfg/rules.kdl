window-rule {
    draw-border-with-background false
    geometry-corner-radius 0
    clip-to-geometry false
    opacity 0.85
    open-maximized true
    background-effect {
        blur true
        xray true
    }
    popups {
        opacity 0.85
        geometry-corner-radius 12
        background-effect {
            blur true
            xray false
        }
    }
}

window-rule {
    match is-floating=true
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^chrome-.*-Default$"#

    open-maximized true
}

// Noctalia settings window
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating false
    open-maximized true
}

/*
  Noctalia
  Disable xray on all our surfaces so it looks more realistic.
  Noctalia publishes blur regions automatically when ext-background-effects is available.
*/
layer-rule {
    match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel|attached-panel|osd)$"#
    background-effect {
        xray false
    }
    popups {
        background-effect {
            blur true
            xray false
        }
    }
}

/* Enable blur on noctalia's window switcher and disable xray. */
layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

/* Place the regular wallpaper on the backdrop. */
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

// window-rule {
//     match app-id=r#"^org\.wezfurlong\.wezterm$"#
//     default-column-width {}
// }

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Steam window rules
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}
